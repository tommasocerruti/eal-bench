# Run artifacts — keep the small manifest.json (the experiment record) tracked so runs are
# reviewable in git; ignore the bulky raw data (trials + every API call) and figures.
logs/
results/**/*.jsonl
results/**/*.png
results/*.jsonl
results/*.png

